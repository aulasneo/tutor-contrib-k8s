    "target": K8S_CMS_KEDA_TARGET_INFLIGHT,
    "scale_up_window": K8S_CMS_HPA_SCALE_UP_STABILIZATION_WINDOW_SECONDS,
    "scale_up_percent": K8S_CMS_HPA_SCALE_UP_PERCENT,
    "scale_up_pods": K8S_CMS_HPA_SCALE_UP_PODS,
    "scale_up_period": K8S_CMS_HPA_SCALE_UP_PERIOD_SECONDS,
    "scale_down_window": K8S_CMS_HPA_SCALE_DOWN_STABILIZATION_WINDOW_SECONDS,
    "scale_down_percent": K8S_CMS_HPA_SCALE_DOWN_PERCENT,
    "scale_down_pods": K8S_CMS_HPA_SCALE_DOWN_PODS,
    "scale_down_period": K8S_CMS_HPA_SCALE_DOWN_PERIOD_SECONDS,
  },
  {
    "enabled": K8S_MFE_KEDA_ENABLE,
    "name": "mfe",
    "host": K8S_MFE_METRICS_HOST,
    "replicas": K8S_MFE_REPLICAS,
    "max_replicas": K8S_MFE_MAX_REPLICAS,
    "target": K8S_MFE_KEDA_TARGET_INFLIGHT,
    "scale_up_window": K8S_MFE_HPA_SCALE_UP_STABILIZATION_WINDOW_SECONDS,
    "scale_up_percent": K8S_MFE_HPA_SCALE_UP_PERCENT,
    "scale_up_pods": K8S_MFE_HPA_SCALE_UP_PODS,
    "scale_up_period": K8S_MFE_HPA_SCALE_UP_PERIOD_SECONDS,
    "scale_down_window": K8S_MFE_HPA_SCALE_DOWN_STABILIZATION_WINDOW_SECONDS,
    "scale_down_percent": K8S_MFE_HPA_SCALE_DOWN_PERCENT,
    "scale_down_pods": K8S_MFE_HPA_SCALE_DOWN_PODS,
    "scale_down_period": K8S_MFE_HPA_SCALE_DOWN_PERIOD_SECONDS,
  },
] %}
{% for workload in K8S_WEB_KEDA_WORKLOADS if workload.enabled %}
---
apiVersion: keda.sh/v1alpha1
kind: ScaledObject
metadata:
  name: {{ workload.name }}
  namespace: {{ K8S_NAMESPACE }}
  labels:
    app.kubernetes.io/name: {{ workload.name }}
spec:
  scaleTargetRef:
    name: {{ workload.name }}
  pollingInterval: {{ K8S_KEDA_POLLING_INTERVAL_SECONDS }}
  minReplicaCount: {{ [workload.replicas, 1] | max }}
  maxReplicaCount: {{ workload.max_replicas }}
  fallback:
    failureThreshold: {{ K8S_KEDA_FALLBACK_FAILURE_THRESHOLD }}
    replicas: {{ [K8S_KEDA_FALLBACK_REPLICAS, 1] | max }}
  advanced:
    restoreToOriginalReplicaCount: false
    horizontalPodAutoscalerConfig:
      name: {{ workload.name }}-keda-hpa
      behavior:
        scaleUp:
          stabilizationWindowSeconds: {{ workload.scale_up_window }}
          selectPolicy: Max
          policies:
            - type: Percent
              value: {{ workload.scale_up_percent }}
              periodSeconds: {{ workload.scale_up_period }}
            - type: Pods
              value: {{ workload.scale_up_pods }}
              periodSeconds: {{ workload.scale_up_period }}
        scaleDown:
          stabilizationWindowSeconds: {{ workload.scale_down_window }}
          selectPolicy: Min
          policies:
            - type: Percent
              value: {{ workload.scale_down_percent }}
              periodSeconds: {{ workload.scale_down_period }}
            - type: Pods
              value: {{ workload.scale_down_pods }}
              periodSeconds: {{ workload.scale_down_period }}
  triggers:
    - type: metrics-api
      metricType: AverageValue
      metadata:
        url: "{{ K8S_CADDY_METRICS_URL }}"
        format: prometheus
        valueLocation: 'caddy_http_requests_in_flight{host="{{ workload.host }}",handler="reverse_proxy"}'
        targetValue: "{{ workload.target }}"
        aggregateFromKubeServiceEndpoints: "true"
        aggregationType: sum
{% endfor %}

