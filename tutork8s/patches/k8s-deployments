    {% endif %}
  behavior:
    scaleUp:
      stabilizationWindowSeconds: {{ K8S_LMS_HPA_SCALE_UP_STABILIZATION_WINDOW_SECONDS }}
      selectPolicy: Max
      policies:
        - type: Percent
          value: {{ K8S_LMS_HPA_SCALE_UP_PERCENT }}
          periodSeconds: {{ K8S_LMS_HPA_SCALE_UP_PERIOD_SECONDS }}
        - type: Pods
          value: {{ K8S_LMS_HPA_SCALE_UP_PODS }}
          periodSeconds: {{ K8S_LMS_HPA_SCALE_UP_PERIOD_SECONDS }}
    scaleDown:
