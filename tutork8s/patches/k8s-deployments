# Start of tutor-contrib-k8s patches
{% set K8S_WEB_KEDA_ENABLED = K8S_LMS_KEDA_ENABLE or K8S_CMS_KEDA_ENABLE or K8S_MFE_KEDA_ENABLE or K8S_CADDY_KEDA_ENABLE %}
{% set K8S_CADDY_METRICS_URL = "http://caddy-metrics." ~ K8S_NAMESPACE ~ ".svc.cluster.local:" ~ K8S_CADDY_METRICS_PORT ~ "/metrics" %}
{% set K8S_MFE_METRICS_HOST = K8S_MFE_KEDA_HOST or "apps." ~ LMS_HOST %}
{% if K8S_WEB_KEDA_ENABLED %}
---
apiVersion: v1
kind: Service
metadata:
  name: caddy-metrics
  namespace: {{ K8S_NAMESPACE }}
  labels:
    app.kubernetes.io/name: caddy-metrics
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: caddy
  ports:
    - name: metrics
      port: {{ K8S_CADDY_METRICS_PORT }}
      targetPort: {{ K8S_CADDY_METRICS_PORT }}
      protocol: TCP
{% endif %}

