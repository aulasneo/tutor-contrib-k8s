    "name": "lms",
    "host": LMS_HOST,
    "replicas": K8S_LMS_REPLICAS,
    "max_replicas": K8S_LMS_MAX_REPLICAS,
    "target": K8S_LMS_KEDA_TARGET_INFLIGHT,
    "scale_up_window": K8S_LMS_HPA_SCALE_UP_STABILIZATION_WINDOW_SECONDS,
    "scale_up_percent": K8S_LMS_HPA_SCALE_UP_PERCENT,
    "scale_up_pods": K8S_LMS_HPA_SCALE_UP_PODS,
