{% if (K8S_LMS_WORKER_KEDA_ENABLE or K8S_CMS_WORKER_KEDA_ENABLE) and REDIS_USERNAME and REDIS_PASSWORD %}
---
apiVersion: v1
kind: Secret
metadata:
  name: keda-redis-auth
  namespace: {{ K8S_NAMESPACE }}
type: Opaque
stringData:
  username: |-
    {{ REDIS_USERNAME }}
  password: |-
    {{ REDIS_PASSWORD }}
---
apiVersion: keda.sh/v1alpha1
kind: TriggerAuthentication
metadata:
  name: keda-redis-auth
  namespace: {{ K8S_NAMESPACE }}
spec:
  secretTargetRef:
    - parameter: username
      name: keda-redis-auth
      key: username
    - parameter: password
      name: keda-redis-auth
      key: password
{% endif %}
{% for worker in K8S_WORKER_KEDA_WORKLOADS if worker.enabled %}
---
apiVersion: keda.sh/v1alpha1
kind: ScaledObject
metadata:
  name: {{ worker.name }}
  namespace: {{ K8S_NAMESPACE }}
  labels:
    app.kubernetes.io/name: {{ worker.name }}
spec:
  scaleTargetRef:
    name: {{ worker.name }}
  pollingInterval: {{ K8S_KEDA_POLLING_INTERVAL_SECONDS }}
  minReplicaCount: {{ [worker.replicas, 1] | max }}
  maxReplicaCount: {{ worker.max_replicas }}
  fallback:
    failureThreshold: {{ K8S_KEDA_FALLBACK_FAILURE_THRESHOLD }}
    replicas: {{ [K8S_KEDA_FALLBACK_REPLICAS, 1] | max }}
  advanced:
    restoreToOriginalReplicaCount: false
    horizontalPodAutoscalerConfig:
      name: {{ worker.name }}-keda-hpa
      behavior:
        scaleUp:
          stabilizationWindowSeconds: {{ worker.scale_up_window }}
          selectPolicy: Max
          policies:
            - type: Percent
              value: {{ worker.scale_up_percent }}
              periodSeconds: {{ worker.scale_up_period }}
            - type: Pods
              value: {{ worker.scale_up_pods }}
              periodSeconds: {{ worker.scale_up_period }}
        scaleDown:
          stabilizationWindowSeconds: {{ worker.scale_down_window }}
          selectPolicy: Min
          policies:
            - type: Percent
              value: {{ worker.scale_down_percent }}
              periodSeconds: {{ worker.scale_down_period }}
            - type: Pods
              value: {{ worker.scale_down_pods }}
              periodSeconds: {{ worker.scale_down_period }}
    scalingModifiers:
      target: "{{ worker.target }}"
      activationTarget: "0"
      metricType: AverageValue
      formula: "0{% for queue in worker.queues %}{% set queue_index = loop.index0 %}{% for priority in K8S_KEDA_REDIS_PRIORITY_STEPS %} + q{{ queue_index }}p{{ priority }}{% endfor %}{% endfor %}"
  triggers:
    {% for queue in worker.queues %}
    {% set queue_index = loop.index0 %}
    {% for priority in K8S_KEDA_REDIS_PRIORITY_STEPS %}
    - type: redis
      name: q{{ queue_index }}p{{ priority }}
      metricType: AverageValue
      metadata:
        address: "{{ REDIS_HOST }}:{{ REDIS_PORT }}"
        databaseIndex: "{{ OPENEDX_CELERY_REDIS_DB }}"
        listName: "{{ queue }}{% if priority != 0 %}\u0006\u0016{{ priority }}{% endif %}"
        listLength: "{{ worker.target }}"
        enableTLS: "{{ K8S_KEDA_REDIS_TLS_ENABLE | lower }}"
        unsafeSsl: "{{ K8S_KEDA_REDIS_UNSAFE_SSL | lower }}"
      {% if REDIS_USERNAME and REDIS_PASSWORD %}
      authenticationRef:
        name: keda-redis-auth
      {% endif %}
    {% endfor %}
    {% endfor %}
{% endfor %}

{% if K8S_CADDY_KEDA_ENABLE %}
{% set K8S_CADDY_KEDA_HOSTS = [LMS_HOST, CMS_HOST] %}
{% if K8S_MFE_KEDA_ENABLE %}
{% set K8S_CADDY_KEDA_HOSTS = K8S_CADDY_KEDA_HOSTS + [K8S_MFE_METRICS_HOST] %}
{% endif %}
{% set K8S_CADDY_KEDA_HOSTS = K8S_CADDY_KEDA_HOSTS + K8S_CADDY_KEDA_EXTRA_HOSTS %}
---
apiVersion: keda.sh/v1alpha1
kind: ScaledObject
metadata:
  name: caddy
  namespace: {{ K8S_NAMESPACE }}
  labels:
    app.kubernetes.io/name: caddy
spec:
  scaleTargetRef:
    name: caddy
  pollingInterval: {{ K8S_KEDA_POLLING_INTERVAL_SECONDS }}
  minReplicaCount: {{ [K8S_CADDY_REPLICAS, 1] | max }}
  maxReplicaCount: {{ K8S_CADDY_MAX_REPLICAS }}
  fallback:
    failureThreshold: {{ K8S_KEDA_FALLBACK_FAILURE_THRESHOLD }}
    replicas: {{ [K8S_KEDA_FALLBACK_REPLICAS, 1] | max }}
  advanced:
    restoreToOriginalReplicaCount: false
    horizontalPodAutoscalerConfig:
      name: caddy-keda-hpa
      behavior:
        scaleUp:
          stabilizationWindowSeconds: {{ K8S_CADDY_HPA_SCALE_UP_STABILIZATION_WINDOW_SECONDS }}
          selectPolicy: Max
          policies:
            - type: Percent
              value: {{ K8S_CADDY_HPA_SCALE_UP_PERCENT }}
              periodSeconds: {{ K8S_CADDY_HPA_SCALE_UP_PERIOD_SECONDS }}
            - type: Pods
              value: {{ K8S_CADDY_HPA_SCALE_UP_PODS }}
              periodSeconds: {{ K8S_CADDY_HPA_SCALE_UP_PERIOD_SECONDS }}
        scaleDown:
          stabilizationWindowSeconds: {{ K8S_CADDY_HPA_SCALE_DOWN_STABILIZATION_WINDOW_SECONDS }}
          selectPolicy: Min
          policies:
            - type: Percent
              value: {{ K8S_CADDY_HPA_SCALE_DOWN_PERCENT }}
              periodSeconds: {{ K8S_CADDY_HPA_SCALE_DOWN_PERIOD_SECONDS }}
            - type: Pods
              value: {{ K8S_CADDY_HPA_SCALE_DOWN_PODS }}
              periodSeconds: {{ K8S_CADDY_HPA_SCALE_DOWN_PERIOD_SECONDS }}
    scalingModifiers:
      target: "{{ K8S_CADDY_KEDA_TARGET_INFLIGHT }}"
      activationTarget: "0"
      metricType: AverageValue
      formula: "0{% for host in K8S_CADDY_KEDA_HOSTS %} + host{{ loop.index0 }}{% endfor %}"
  triggers:
    {% for host in K8S_CADDY_KEDA_HOSTS %}
    - type: metrics-api
      name: host{{ loop.index0 }}
      metricType: AverageValue
      metadata:
        url: "{{ K8S_CADDY_METRICS_URL }}"
        format: prometheus
        valueLocation: 'caddy_http_requests_in_flight{host="{{ host }}",handler="reverse_proxy"}'
        targetValue: "{{ K8S_CADDY_KEDA_TARGET_INFLIGHT }}"
        aggregateFromKubeServiceEndpoints: "true"
        aggregationType: sum
    {% endfor %}
{% endif %}

{% set K8S_LMS_HPA_HAS_METRICS = K8S_LMS_HPA_CPU_ENABLE or K8S_LMS_HPA_MEMORY_ENABLE %}
{% if K8S_LMS_HPA_ENABLE and K8S_LMS_HPA_HAS_METRICS and not K8S_LMS_KEDA_ENABLE %}
