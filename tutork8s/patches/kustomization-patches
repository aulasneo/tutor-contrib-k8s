{% for host, body_size in [(LMS_HOST, K8S_LMS_INGRESS_PROXY_BODY_SIZE), (CMS_HOST, K8S_CMS_INGRESS_PROXY_BODY_SIZE)] %}
{% if body_size %}
{% set ingress_name = (host | replace(".", "-")) ~ "-to-caddy" %}
- target:
    group: networking.k8s.io
    version: v1
    kind: Ingress
    name: {{ ingress_name | tojson }}
  patch: |-
    apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      name: {{ ingress_name | tojson }}
      annotations:
        nginx.ingress.kubernetes.io/proxy-body-size: {{ body_size | string | tojson }}
{% endif %}
{% endfor %}
{% if K8S_CADDY_LMS_KEEPALIVE and K8S_CADDY_LMS_KEEPALIVE | string | lower not in ["0", "none"] %}
{% set caddyfile %}{% include "apps/caddy/Caddyfile" %}{% endset %}
- target:
    version: v1
    kind: ConfigMap
    name: caddy-config
  patch: |-
    - op: replace
      path: /data/Caddyfile
      value: |
        {{ caddyfile | k8s_lms_keepalive(K8S_CADDY_LMS_KEEPALIVE) | trim | indent(8) }}
{% endif %}
